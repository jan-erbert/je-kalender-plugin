{
  "name": "jan-erbert/je-kalender-plugin",
  "description": "Development tooling for the JE Kalender WordPress plugin.",
  "type": "wordpress-plugin",
  "license": "MIT",
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.1",
    "php-stubs/wordpress-stubs": "^7.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "wp-coding-standards/wpcs": "^3.2"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "lint": "php -l je-kalender.php && find includes -name '*.php' -print0 | xargs -0 -n1 php -l",
    "phpcs": "phpcs",
    "phpcbf": "phpcbf"
  }
}
